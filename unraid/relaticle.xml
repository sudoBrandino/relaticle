  <Config Name="APP_NAME" Target="APP_NAME" Default="Relaticle" Mode="" Description="Application name" Type="Variable" Display="always" Required="false" Mask="false">Relaticle</Config>
  <Config Name="APP_ENV" Target="APP_ENV" Default="production" Mode="" Description="Application environment (production recommended)" Type="Variable" Display="always" Required="true" Mask="false">production</Config>
  <Config Name="APP_KEY" Target="APP_KEY" Default="" Mode="" Description="Application encryption key (REQUIRED - generate using command in overview)" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="APP_DEBUG" Target="APP_DEBUG" Default="false" Mode="" Description="Enable debug mode (false for production)" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="APP_URL" Target="APP_URL" Default="http://localhost" Mode="" Description="Full application URL (e.g., https://crm.yourdomain.com)" Type="Variable" Display="always" Required="true" Mask="false">http://localhost</Config>
  <Config Name="LOG_CHANNEL" Target="LOG_CHANNEL" Default="stderr" Mode="" Description="Logging channel" Type="Variable" Display="advanced" Required="false" Mask="false">stderr</Config>

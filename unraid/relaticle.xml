<?xml version="1.0"?>
<Container version="2">
  <Name>Relaticle</Name>
  <Repository>ghcr.io/relaticle/relaticle:latest</Repository>
  <Registry>https://ghcr.io/relaticle/relaticle</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Relaticle/relaticle/discussions</Support>
  <Project>https://relaticle.com</Project>
  <Overview>Relaticle is a powerful, adaptable open-source CRM platform built for teams who've outgrown spreadsheets but find Salesforce overkill. Built on Laravel 12, PHP 8.4, and Filament 4 with complete data ownership through self-hosting.&#xD;
&#xD;
[b]Features:[/b]&#xD;
- Fully Customizable with no-code custom fields&#xD;
- Multi-Team Support with isolated workspaces&#xD;
- Modern Technology Stack (Laravel 12, PHP 8.4, Filament 4)&#xD;
- Privacy-Focused Self-Hosting&#xD;
- Open Source (AGPL-3.0)&#xD;
&#xD;
[b]Requirements:[/b]&#xD;
- PostgreSQL 16 (recommended to use separate Postgres container)&#xD;
- Redis (recommended to use separate Redis container)&#xD;
&#xD;
[b]Initial Setup:[/b]&#xD;
1. Start PostgreSQL and Redis containers first&#xD;
2. Generate APP_KEY by running: docker run --rm ghcr.io/relaticle/relaticle:latest php artisan key:generate --show&#xD;
3. Copy the generated key (starts with base64:)&#xD;
4. Paste it into the APP_KEY field below&#xD;
5. Configure database and Redis connection details&#xD;
6. Start the container&#xD;
7. Access Relaticle at http://[IP]:[PORT]&#xD;
&#xD;
[b]Note:[/b] This template requires PostgreSQL and Redis. You can install them from Community Applications or use the stack deployment method for an all-in-one solution.</Overview>
  <Category>Productivity: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Relaticle/relaticle/main/unraid/relaticle.xml</TemplateURL>
  <Icon>https://relaticle.com/relaticle-logo.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>PostgreSQL 16 and Redis containers running</Requires>

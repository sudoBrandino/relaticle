  <Config Name="MAIL_FROM_ADDRESS" Target="MAIL_FROM_ADDRESS" Default="hello@example.com" Mode="" Description="From email address" Type="Variable" Display="advanced" Required="false" Mask="false">hello@example.com</Config>

  <Config Name="DB_USERNAME" Target="DB_USERNAME" Default="relaticle" Mode="" Description="Database username" Type="Variable" Display="always" Required="true" Mask="false">relaticle</Config>
  <Config Name="DB_PASSWORD" Target="DB_PASSWORD" Default="" Mode="" Description="Database password (REQUIRED)" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="REDIS_HOST" Target="REDIS_HOST" Default="" Mode="" Description="Redis host (IP or container name)" Type="Variable" Display="always" Required="true" Mask="false"></Config>

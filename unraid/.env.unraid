# Relaticle CRM - Unraid Environment Configuration
# Copy this file to .env and customize the values

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application name (shown in UI)
APP_NAME=Relaticle

# Environment (production recommended for Unraid)
APP_ENV=production

# Debug mode (false for production, true for troubleshooting)
APP_DEBUG=false

# Timezone (see: https://www.php.net/manual/en/timezones.php)
APP_TIMEZONE=UTC

# Application URL (update with your Unraid server IP or domain)
# Examples: http://192.168.1.100:8080 or https://crm.yourdomain.com
APP_URL=http://localhost:8080

# Port to expose application (default: 8080)
APP_PORT=8080

# ============================================
# SECURITY - REQUIRED
# ============================================

# Application encryption key (REQUIRED)
# Generate with: docker run --rm ghcr.io/relaticle/relaticle:latest php artisan key:generate --show
# Paste the full output including "base64:" prefix
APP_KEY=

# ============================================
# DATABASE CONFIGURATION - REQUIRED
# ============================================

# Database name
DB_DATABASE=relaticle

# Database username
DB_USERNAME=relaticle

# Database password (REQUIRED - use a strong password)
# Generate random: openssl rand -base64 32
DB_PASSWORD=

# ============================================
# REDIS CONFIGURATION
# ============================================

# Redis password (optional, use 'null' for no password)
# For additional security, set a password: openssl rand -base64 32
REDIS_PASSWORD=null

# ============================================
# LOGGING
# ============================================

# Log channel (stderr recommended for Docker)
LOG_CHANNEL=stderr

# Log level (debug, info, notice, warning, error, critical, alert, emergency)
# Use 'warning' or 'error' for production, 'debug' for troubleshooting
LOG_LEVEL=warning

# ============================================
# STORAGE PATH (Unraid specific)
# ============================================

# Path to appdata directory on Unraid
# Default: /mnt/user/appdata/relaticle
APPDATA_PATH=/mnt/user/appdata/relaticle

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================

# Mail driver (log, smtp, sendmail, mailgun, postmark, ses)
# Use 'log' to disable email sending (emails saved to logs)
MAIL_MAILER=log

# SMTP Configuration (if using SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# From address and name
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Relaticle

# ============================================
# OAUTH PROVIDERS (Optional)
# ============================================

# Google OAuth
# Get credentials: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# GitHub OAuth
# Get credentials: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# ADVANCED SETTINGS
# ============================================

# System admin panel configuration
# Access via: http://your-url/sysadmin (path-based)
# Or set SYSADMIN_DOMAIN for subdomain access
SYSADMIN_PATH=sysadmin
# SYSADMIN_DOMAIN=sysadmin.example.com

# Session configuration
SESSION_LIFETIME=120
SESSION_DRIVER=redis

# Cache configuration
CACHE_STORE=redis

# Queue configuration
QUEUE_CONNECTION=redis

# Laravel Automations (recommended for Unraid - do not change unless you know what you're doing)
AUTORUN_ENABLED=true
AUTORUN_LARAVEL_MIGRATION=true
AUTORUN_LARAVEL_MIGRATION_ISOLATION=true
AUTORUN_LARAVEL_STORAGE_LINK=true
AUTORUN_LARAVEL_CONFIG_CACHE=true
AUTORUN_LARAVEL_ROUTE_CACHE=true
AUTORUN_LARAVEL_VIEW_CACHE=true

# ============================================
# MONITORING & ANALYTICS (Optional)
# ============================================

# Sentry error tracking
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Fathom analytics
FATHOM_ANALYTICS_SITE_ID=

# ============================================
# NOTES
# ============================================

# Required values to set:
# 1. APP_KEY - Generate using command shown above
# 2. DB_PASSWORD - Set a strong password
# 3. APP_URL - Update with your server IP or domain
#
# Optional but recommended:
# 1. MAIL_* - Configure for email notifications
# 2. APP_TIMEZONE - Set to your local timezone
# 3. REDIS_PASSWORD - Add Redis password for security
#
# After editing this file, deploy with:
# docker compose -f docker-compose-unraid.yml up -d
